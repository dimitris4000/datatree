{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Product CSV row",
  "description": "Validate each products.csv row parsed as an object using the header names. All cells remain strings; no type coercion. An empty notes cell is an empty string.",
  "type": "object",
  "additionalProperties": false,
  "required": ["sku", "name", "category", "price", "stock", "active", "notes"],
  "properties": {
    "sku": { "type": "string", "pattern": "^P[0-9]{3}$" },
    "name": { "type": "string", "minLength": 1 },
    "category": { "enum": ["Stationery", "Kitchen", "Gifts"] },
    "price": { "type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$" },
    "stock": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
    "active": { "enum": ["true", "false"] },
    "notes": { "type": "string" }
  }
}
